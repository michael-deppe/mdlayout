		% contains the first cell when trimleadingspaces=false. TABs have already
		% been normalized to ordinary spaces by the raw collector.
		\str_if_eq:eeTF {#1} { \char_generate:nn {30}{12} }
		{
			% Buffered whitespace belonged to a blank/whitespace-only source line.
			\tl_clear:N \l__mdrt_body_start_ws_tl
		}
		{
			\str_if_eq:nnTF {#1} { ~ }
			{
