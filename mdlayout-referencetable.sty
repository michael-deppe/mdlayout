{%
\par
\def\MD@RT@Caption{}%
\def\MD@RT@Label{}%
% Empty here means "use the last column"; explicit xcolumns= overrides it.
\def\MD@RT@XColumns{}%
\def\MD@RT@XWeights{}%
\def\MD@RT@TypewriterColumns{}%
\def\MD@RT@VerbatimColumns{}%
\def\MD@RT@LeftColumns{}%
\def\MD@RT@CenterColumns{}%
\def\MD@RT@RightColumns{}%
\def\MD@RT@Area{full}%
\def\MD@RT@MarginWidth{}%
\def\MD@RT@GutterWidth{}%
\def\MD@RT@ColumnCount{3}%
\MD@RT@TrimLeadingSpacestrue
\def\MD@RT@TabSpaces{1}%
\def\MD@RT@Headers{arguments}%
\setkeys{MDReferenceTable}{#1}%
\MD@RT@DispatchTableStart
}%
{%
% Intentionally empty. The scanner consumes \end{ReferenceTable}.
}

