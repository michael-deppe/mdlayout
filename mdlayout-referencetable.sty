% Normalize all public header spellings to the three internal modes
% arguments, row, and none.  The order in the option list therefore has the
% usual meaning: the last header/headers setting wins.
\newcommand*{\MD@RT@SetHeaders}[1]{%
	\ifstrequal{#1}{arguments}{%
		\def\MD@RT@Headers{arguments}%
	}{%
		\ifstrequal{#1}{row}{%
			\def\MD@RT@Headers{row}%
		}{%
			\ifstrequal{#1}{none}{%
				\def\MD@RT@Headers{none}%
			}{%
				\ifstrequal{#1}{false}{%
					\def\MD@RT@Headers{none}%
				}{%
					\PackageError{mdlayout-referencetable}%
					{Unknown headers value `#1'}%
					{Valid values are arguments, row, none, and false.}%
				}%
			}%
		}%
	}%
}

\define@key{MDReferenceTable}{headers}{%
	\MD@RT@SetHeaders{#1}%
}

% Compatibility alias retained from v0.4.0.
\define@key{MDReferenceTable}{header}[true]{%
	\ifstrequal{#1}{true}{%
		\def\MD@RT@Headers{arguments}%
	}{%
		\ifstrequal{#1}{false}{%
			\def\MD@RT@Headers{none}%
		}{%
			\PackageError{mdlayout-referencetable}%
			{Unknown header value `#1'}%
			{Valid values are true and false.}%
		}%
	}%
}


% ==========================================================================
% Area geometry
%
% This package is self-contained.  It does not require mdlayout.sty.
%
% Geometry source, in order of precedence:
%
%   1. ReferenceTable options marginwidth= and/or gutter=
%   2. mdlayout public dimensions, if mdlayout is loaded
%   3. ordinary LaTeX dimensions \marginparwidth and \marginparsep
%
% The resulting geometry follows the same relations used by mdlayout:
%
%   wide offset = margin width + gutter width
%   full width  = text width + wide offset
%   half offset = 0.5 * wide offset
%   half width  = text width + half offset
%
% area=full    -> offset = wide offset
%                 width  = full width
%
% area=half    -> offset = half offset
%                 width  = half width
%
% area=text    -> offset = 0
%                 width  = text width
%
% Default: full
% ==========================================================================

\newdimen\MD@RT@AreaOffset
\newdimen\MD@RT@AreaWidth
\newdimen\MD@RT@TextWidth
\newdimen\MD@RT@MarginWidthDim
\newdimen\MD@RT@GutterWidthDim
\newdimen\MD@RT@WideOffset
\newdimen\MD@RT@FullWidth
\newdimen\MD@RT@HalfOffset
\newdimen\MD@RT@HalfWidth

\newif\ifMD@RT@UseMDLayoutGeometry

\newcommand*{\MD@RT@CalculateStandaloneGeometry}{%
	\MD@RT@TextWidth=\textwidth\relax
	\ifx\MD@RT@MarginWidth\@empty
		\MD@RT@MarginWidthDim=\marginparwidth\relax
	\else
		\MD@RT@MarginWidthDim=\MD@RT@MarginWidth\relax
	\fi
	\ifx\MD@RT@GutterWidth\@empty
		\MD@RT@GutterWidthDim=\marginparsep\relax
	\else
		\MD@RT@GutterWidthDim=\MD@RT@GutterWidth\relax
	\fi
	\MD@RT@WideOffset=\dimexpr
		\MD@RT@MarginWidthDim+\MD@RT@GutterWidthDim
	\relax
	\MD@RT@FullWidth=\dimexpr
		\MD@RT@TextWidth+\MD@RT@WideOffset
	\relax
	\MD@RT@HalfOffset=.5\MD@RT@WideOffset
	\MD@RT@HalfWidth=\dimexpr
		\MD@RT@TextWidth+\MD@RT@HalfOffset
	\relax
}

\newcommand*{\MD@RT@CalculateGeometry}{%
	% Exact mdlayout compatibility is used only when the user has supplied
	% no local geometry override and all five public dimensions exist.
	\MD@RT@UseMDLayoutGeometrytrue
	\ifx\MD@RT@MarginWidth\@empty\else
		\MD@RT@UseMDLayoutGeometryfalse
	\fi
	\ifx\MD@RT@GutterWidth\@empty\else
		\MD@RT@UseMDLayoutGeometryfalse
	\fi
	\@ifundefined{mdTextWidth}{\MD@RT@UseMDLayoutGeometryfalse}{}
	\@ifundefined{mdFullWidth}{\MD@RT@UseMDLayoutGeometryfalse}{}
	\@ifundefined{mdWideOffset}{\MD@RT@UseMDLayoutGeometryfalse}{}
	\@ifundefined{mdHalfOffset}{\MD@RT@UseMDLayoutGeometryfalse}{}
	\@ifundefined{mdHalfWidth}{\MD@RT@UseMDLayoutGeometryfalse}{}

	\ifMD@RT@UseMDLayoutGeometry
		\MD@RT@TextWidth=\mdTextWidth\relax
		\MD@RT@FullWidth=\mdFullWidth\relax
		\MD@RT@WideOffset=\mdWideOffset\relax
		\MD@RT@HalfOffset=\mdHalfOffset\relax
		\MD@RT@HalfWidth=\mdHalfWidth\relax
	\else
		\MD@RT@CalculateStandaloneGeometry
	\fi
}

\newcommand*{\MD@RT@SelectArea}{%
	\MD@RT@CalculateGeometry
	\ifdefstring{\MD@RT@Area}{full}
	{%
		\MD@RT@AreaOffset=\MD@RT@WideOffset
		\MD@RT@AreaWidth=\MD@RT@FullWidth
	}
	{%
		\ifdefstring{\MD@RT@Area}{half}
		{%
			\MD@RT@AreaOffset=\MD@RT@HalfOffset
			\MD@RT@AreaWidth=\MD@RT@HalfWidth
		}
		{%
			\ifdefstring{\MD@RT@Area}{text}
			{%
				\MD@RT@AreaOffset=0pt
				\MD@RT@AreaWidth=\MD@RT@TextWidth
			}
			{%
				\PackageError{mdlayout-referencetable}
				{Unknown area `\MD@RT@Area'}
				{Valid values are area=full, area=half, and area=text.}%
				%
				% Safe fallback.
				\MD@RT@AreaOffset=\MD@RT@WideOffset
				\MD@RT@AreaWidth=\MD@RT@FullWidth
			}%
		}%
	}%
}


% ==========================================================================
% Parameterized longtable area
%
% This is the ReferenceTable wide longtable area.
% The offset and width are selected by area=.
%
% Geometry is calculated locally, with optional compatibility use of
% mdlayout's public dimensions when mdlayout happens to be loaded.
% ==========================================================================

\newenvironment{MDReferenceTableArea}
{%
	\par
	\begingroup
	
	\vspace{\MD@RT@PreSkip}%
	\ifdefempty{\MD@RT@Caption}
	{}
	{\vspace{\MD@RT@CaptionPreSkip}}%
	
	% No vertical spacing from longtable.
	\setlength{\LTpre}{0pt}%
	\setlength{\LTpost}{0pt}%
	% TEST: no adjustwidth
	%\begin{adjustwidth}{-\MD@RT@AreaOffset}{0pt}%
		
		% Present selected area as local typesetting area.
		
		\textwidth=\MD@RT@AreaWidth
		\linewidth=\MD@RT@AreaWidth
		\columnwidth=\MD@RT@AreaWidth
		\hsize=\MD@RT@AreaWidth
		
		% longtable / ltablex alignment.
		%
		% xltabular ultimately enters longtable with its neutral [x]
		% alignment. In that mode longtable leaves \LTleft and \LTright
		% unchanged, so the public lengths are sufficient; no patching of
		% private longtable internals is needed.
		\LTleft=-\MD@RT@AreaOffset\relax
		\LTright=0pt\relax
		
		% caption/ltcaption compatibility.
		%
		% Prevent caption from applying the longtable offset a second time.
		
		\@ifundefined{caption@LT@config}
		{}
		{%
			\let\MD@RT@SavedCaptionLTConfig\caption@LT@config
			
			\renewcommand*\caption@LT@config{%
				\MD@RT@SavedCaptionLTConfig
				\xdef\caption@LTleft{0pt}%
				\xdef\caption@LTright{0pt}%
				\xdef\caption@LTfmt{@{}l@{}}%
			}%
		}%
	}
	{%
	% TEST: no adjustwidth
	% \end{adjustwidth}%
	\endgroup
	\vspace{\MD@RT@PostSkip}%
	\par
}


% ==========================================================================
% Column-list tests and alignment (v0.3.0)
% ==========================================================================

\newif\ifMD@RT@XColumn
\newif\ifMD@RT@Typewriter
\newif\ifMD@RT@Left
\newif\ifMD@RT@Center
\newif\ifMD@RT@Right

\newcommand*{\MD@RT@TestXColumn}[1]{%
	\MD@RT@XColumnfalse
	\edef\MD@RT@TestCommand{\noexpand\in@{+#1+}{+\MD@RT@XColumns+}}%
	\MD@RT@TestCommand
	\ifin@\MD@RT@XColumntrue\fi
}

\newcommand*{\MD@RT@TestTypewriter}[1]{%
	\MD@RT@Typewriterfalse
	\edef\MD@RT@TestCommand{\noexpand\in@{+#1+}{+\MD@RT@TypewriterColumns+}}%
	\MD@RT@TestCommand
	\ifin@\MD@RT@Typewritertrue\fi
}

\newcommand*{\MD@RT@TestAlignment}[1]{%
	\MD@RT@Leftfalse \MD@RT@Centerfalse \MD@RT@Rightfalse
	\edef\MD@RT@TestCommand{\noexpand\in@{+#1+}{+\MD@RT@LeftColumns+}}%
	\MD@RT@TestCommand \ifin@\MD@RT@Lefttrue\fi
	\edef\MD@RT@TestCommand{\noexpand\in@{+#1+}{+\MD@RT@CenterColumns+}}%
	\MD@RT@TestCommand \ifin@\MD@RT@Centertrue\fi
	\edef\MD@RT@TestCommand{\noexpand\in@{+#1+}{+\MD@RT@RightColumns+}}%
	\MD@RT@TestCommand \ifin@\MD@RT@Righttrue\fi
	\@tempcnta=0\relax
	\ifMD@RT@Left    \advance\@tempcnta by 1\relax\fi
	\ifMD@RT@Center  \advance\@tempcnta by 1\relax\fi
	\ifMD@RT@Right   \advance\@tempcnta by 1\relax\fi
	\ifnum\@tempcnta>1\relax
	\PackageError{mdlayout-referencetable}%
	{Column #1 has more than one alignment}%
	{Use column #1 in only one of leftcolumns, centercolumns, or rightcolumns.}%
	\fi
}

% v0.5.2: prepare normalized width factors for the selected X columns.
\ExplSyntaxOn
\seq_new:N \l__mdrt_xcolumns_seq
\seq_new:N \l__mdrt_xweights_seq
\fp_new:N  \l__mdrt_xweights_sum_fp
\fp_new:N  \l__mdrt_xfactor_fp
\bool_new:N \l__mdrt_xweights_valid_bool
\tl_new:N \l__mdrt_colon_tl
\cs_generate_variant:Nn \seq_set_split:Nnn { NVV }

\cs_new_protected:Npn \__mdrt_equal_xweights:
  {
    \seq_map_inline:Nn \l__mdrt_xcolumns_seq
      { \cs_gset:cpn {MD@RT@XFactor@\tl_trim_spaces:n{##1}} {1} }
  }

\cs_new_protected:Npn \MDRTPrepareXWeights
  {
    \tl_set:Nx \l_tmpa_tl {\MD@RT@XColumns}
    \seq_set_split:NnV \l__mdrt_xcolumns_seq {+} \l_tmpa_tl
    \tl_set:Nx \l_tmpa_tl {\MD@RT@XWeights}
    \tl_if_blank:VTF \l_tmpa_tl
      { \__mdrt_equal_xweights: }
      {
        \tl_set:Nx \l__mdrt_colon_tl {\char_generate:nn {58}{12}}
        \seq_set_split:NVV \l__mdrt_xweights_seq \l__mdrt_colon_tl \l_tmpa_tl
        \bool_set_true:N \l__mdrt_xweights_valid_bool
        \int_compare:nNnF {\seq_count:N\l__mdrt_xweights_seq} = {\seq_count:N\l__mdrt_xcolumns_seq}
          {
            \bool_set_false:N \l__mdrt_xweights_valid_bool
            \PackageError{mdlayout-referencetable}
              {Number of xweights does not match xcolumns}
              {The number of weights must equal the number of X columns.}
          }
        \bool_if:NT \l__mdrt_xweights_valid_bool
          {
            \fp_zero:N \l__mdrt_xweights_sum_fp
            \seq_map_inline:Nn \l__mdrt_xweights_seq
              {
                \fp_compare:nNnTF {##1} > {0}
                  {\fp_add:Nn \l__mdrt_xweights_sum_fp {##1}}
                  {
                    \bool_set_false:N \l__mdrt_xweights_valid_bool
                    \PackageError{mdlayout-referencetable}
                      {Invalid xweights=\MD@RT@XWeights}
                      {Every X-column weight must be a positive number.}
                  }
              }
          }
        \bool_if:NTF \l__mdrt_xweights_valid_bool
          {
            \seq_map_indexed_inline:Nn \l__mdrt_xweights_seq
              {
                \fp_set:Nn \l__mdrt_xfactor_fp
                  {\seq_count:N\l__mdrt_xcolumns_seq * (##2) / \l__mdrt_xweights_sum_fp}
                \tl_set:Nx \l_tmpb_tl {\seq_item:Nn\l__mdrt_xcolumns_seq{##1}}
                \cs_gset:cpx {MD@RT@XFactor@\tl_trim_spaces:V\l_tmpb_tl}
                  {\fp_to_decimal:N\l__mdrt_xfactor_fp}
              }
          }
          {\__mdrt_equal_xweights:}
      }
  }
\ExplSyntaxOff

% Build the pre-column modifier.  For X columns the alignment must be
% expressed with declarations; ordinary columns can use l/c/r directly.
\newcommand*{\MD@RT@BuildOneColumn}[1]{%
	\MD@RT@TestXColumn{#1}%
	\MD@RT@TestTypewriter{#1}%
	\MD@RT@TestAlignment{#1}%
	
	\def\MD@RT@Prefix{}%
	\ifMD@RT@Typewriter
		\def\MD@RT@Prefix{\ttfamily}%
	\fi
	
	\ifMD@RT@XColumn
		\def\MD@RT@BaseColumn{X}%
		\ifcsname MD@RT@XFactor@#1\endcsname
			\edef\MD@RT@XFactor{\csname MD@RT@XFactor@#1\endcsname}%
		\else
			\def\MD@RT@XFactor{1}%
		\fi
		\ifMD@RT@Center
			\def\MD@RT@AlignDecl{\centering\arraybackslash}%
		\else\ifMD@RT@Right
			\def\MD@RT@AlignDecl{\raggedleft\arraybackslash}%
		\else
			\def\MD@RT@AlignDecl{\raggedright\arraybackslash}%
		\fi\fi
		\edef\MD@RT@BuiltColumn{%
			>{\noexpand\hsize=\MD@RT@XFactor\noexpand\hsize
			  \noexpand\linewidth=\noexpand\hsize
			  \unexpanded\expandafter{\MD@RT@Prefix}%
			  \unexpanded\expandafter{\MD@RT@AlignDecl}}X%
		}%
	\else
		\ifMD@RT@Center
			\def\MD@RT@BaseColumn{c}%
		\else\ifMD@RT@Right
			\def\MD@RT@BaseColumn{r}%
		\else
			\def\MD@RT@BaseColumn{l}%
		\fi\fi
		\ifMD@RT@Typewriter
			\edef\MD@RT@BuiltColumn{>{\noexpand\ttfamily}\MD@RT@BaseColumn}%
		\else
			\edef\MD@RT@BuiltColumn{\MD@RT@BaseColumn}%
		\fi
	\fi
}

% v0.4.0: build the preamble for any positive number of columns.
% The individual column builder remains unchanged; only accumulation is now
% dynamic instead of storing ColOne ... ColFour.
\newcommand*{\MD@RT@BuildColumnSpec}{%
	\def\MD@RT@ColumnSpec{@{}}%
	\MD@RT@ColumnIndex=1\relax
	\loop
		\expandafter\MD@RT@BuildOneColumn\expandafter{\number\MD@RT@ColumnIndex}%
		\protected@edef\MD@RT@ColumnSpec{%
			\unexpanded\expandafter{\MD@RT@ColumnSpec}%
			\unexpanded\expandafter{\MD@RT@BuiltColumn}%
		}%
		\advance\MD@RT@ColumnIndex by 1\relax
	\ifnum\MD@RT@ColumnIndex<\numexpr\MD@RT@ColumnCount+1\relax
	\repeat
	\protected@edef\MD@RT@ColumnSpec{%
		\unexpanded\expandafter{\MD@RT@ColumnSpec}@{}%
	}%
}

% ==========================================================================
% Verbatim-aware body collector (v0.2.0)
%
% When verbatimcolumns is empty, ReferenceTable continues to use the original
% tabularx body collector.  When at least one verbatim column is selected, the
% environment body is first read with fancyvrb catcodes.  This is essential:
% characters such as #, $, %, _, {, }, and \ must be captured before normal
% LaTeX tokenization can assign their syntactic meanings.
%
% The raw character stream is then split into the selected table cells.  Normal
% cells are retokenized with the document catcode table; verbatim cells retain
% character tokens and are wrapped in \ttfamily.  Thus verbatim material is
% never retokenized with normal LaTeX catcodes.
% ==========================================================================

\ExplSyntaxOn

\tl_new:N   \g__mdrt_raw_body_tl
\tl_new:N   \l__mdrt_body_tl
\tl_new:N   \l__mdrt_cell_tl
\tl_new:N   \l__mdrt_normal_cell_tl
\tl_new:N   \l__mdrt_verbatim_columns_tl
\int_new:N  \l__mdrt_column_int
\bool_new:N \l__mdrt_escape_bool
\bool_new:N \l__mdrt_after_row_bool
\bool_new:N \l__mdrt_at_body_start_bool
\bool_new:N \l__mdrt_at_cell_start_bool
\tl_new:N   \l__mdrt_post_row_tl
\tl_new:N   \l__mdrt_header_tl
\bool_new:N \l__mdrt_parsing_header_bool
\tl_new:N   \l__mdrt_body_start_ws_tl

\cs_new_protected:Npn \MDRTVerbatimClear
{ \tl_gclear:N \g__mdrt_raw_body_tl }

\cs_new_protected:Npn \MDRTVerbatimAppendLine #1
{
	% v0.4.6: normalize literal TABs before the table parser sees them.
	% TAB has no structural meaning in ReferenceTable: '&' separates cells
	% and the column specification determines their formatting.  Converting
	% TABs here also means that the established trimleadingspaces mechanism
	% can handle formerly leading TABs as ordinary spaces.
	\str_map_inline:nn {#1}
	{
