\ExplSyntaxOff

% fancyvrb normally insists that nothing follows \begin{Verbatim...} on the
	% source line.  ReferenceTable is not a verbatim display, so silently discard
	% whitespace remaining after the heading arguments and start with the next
	% physical line.
	\begingroup
	\catcode`\^^M=\active
	\gdef\MD@RT@FVBeginScanning#1^^M{\FV@GetLine}
	\endgroup
	
	\def\MD@RT@EndVerbatimCapture{%
		\global\let\FV@EnvironName\relax
		\endgroup
		\MDRTVerbatimParse
		% The original \end{ReferenceTable} was consumed by the fancyvrb scanner.
	% Continue with the same finalizer used by the original tabularx collector.
	\MD@RT@End
}

\def\MD@RT@StartVerbatimCapture{%
	\MDRTVerbatimClear
	\begingroup
	\def\FV@EnvironName{ReferenceTable}%
	\def\FV@ProcessLine##1{\MDRTVerbatimAppendLine{##1}}%
	\let\FV@FontScanPrep\relax
	\let\@noligs\relax
	\let\FV@BeginScanning\FV@GetLine
	% ReferenceTable source is commonly indented with TABs. fancyvrb normally
	% raises an error for any characters (including whitespace) following
	% \end{ReferenceTable} on its physical source line. For our internal body
	% collector that trailing material is formatting whitespace and is discarded.
	\let\FV@BadEndError\relax
	\let\FV@EndScanning\MD@RT@EndVerbatimCapture
	\FV@Scan
}

% ==========================================================================
% ReferenceTable body scanner
% ==========================================================================

\def\MD@RT@Start#1{%
	\def\TX@{ReferenceTable}%
	{\ifnum0=`}\fi
	\setlength\TX@target{#1}%
	\TX@typeout{Target width: #1 = \the\TX@target}%
	% headers=row must always use the verbatim-aware collector because the
	% first row has to be separated before normal LaTeX tokenization.  The
	% other modes use the established collector selection based on whether
	% verbatim columns are present.
	\ifdefstring{\MD@RT@Headers}{row}{%
		\let\MD@RT@Next\MD@RT@StartVerbatimCapture
	}{%
		\ifx\MD@RT@VerbatimColumns\@empty
			\let\MD@RT@Next\MD@RT@StartNormalCapture
		\else
			\let\MD@RT@Next\MD@RT@StartVerbatimCapture
		\fi
	}%
	\MD@RT@Next
}

\def\MD@RT@StartNormalCapture{%
	\toks@{}%
	\TX@get@body
}


% ==========================================================================
% Caption block
% ==========================================================================

\newcommand*{\MD@RT@CaptionBlock}{%
	\ifx\MD@RT@Caption\@empty
	\else
	\caption{\MD@RT@Caption}%
	\ifx\MD@RT@Label\@empty
	\else
	\label{\MD@RT@Label}%
	\fi
	\\
	\fi
}


% ==========================================================================
% Automatic ReferenceTable heads and feet
% ==========================================================================

\newcommand*{\MD@RT@HeaderTwo}{%
	\toprule
	{\normalfont\bfseries\MD@RT@HeadingOne} &
	{\normalfont\bfseries\MD@RT@HeadingTwo} \\
	\midrule
}

\newcommand*{\MD@RT@HeaderThree}{%
	\toprule
	{\normalfont\bfseries\MD@RT@HeadingOne} &
	{\normalfont\bfseries\MD@RT@HeadingTwo} &
	{\normalfont\bfseries\MD@RT@HeadingThree} \\
	\midrule
}

\newcommand*{\MD@RT@HeaderFour}{%
	\toprule
	{\normalfont\bfseries\MD@RT@HeadingOne} &
	{\normalfont\bfseries\MD@RT@HeadingTwo} &
	{\normalfont\bfseries\MD@RT@HeadingThree} &
	{\normalfont\bfseries\MD@RT@HeadingFour} \\
	\midrule
}

\newcommand*{\MD@RT@Header}{%
	\ifcase\MD@RT@ColumnCount\relax
	\or\or \MD@RT@HeaderTwo
	\or \MD@RT@HeaderThree
	\or \MD@RT@HeaderFour
	\fi
}


\newcommand*{\MD@RT@FirstHead}{%
	\MD@RT@Header
	\endfirsthead
}


\newcommand*{\MD@RT@Head}{%
	\MD@RT@Header
	\endhead
}


\newcommand*{\MD@RT@Foot}{%
	\midrule
	\multicolumn{\MD@RT@ColumnCount}{r}{%
		\normalfont\small\textit{continued\ldots}%
	}
	\\
	\endfoot
}


\newcommand*{\MD@RT@LastFoot}{%
	\bottomrule
	\endlastfoot
}


% Emit the traditional automatic structure only when header=true.
% Captions remain independent and are therefore handled outside this switch.
\newcommand*{\MD@RT@AutomaticStructure}{}

% Resolve all conditionals before the material is placed into the alignment.
% In particular, do not let an \if... span alignment tabs (&).
\newcommand*{\MD@RT@RowHeader}{}%

\newcommand*{\MD@RT@PrepareAutomaticStructure}{%
	\ifdefstring{\MD@RT@Headers}{none}{%
		% Bare table: no top/mid/bottom rules, no repeated head, and no
		% continuation footer.  Explicit table commands in the body remain
		% entirely under user control.
		\let\MD@RT@AutomaticStructure\@empty
	}{%
		\ifdefstring{\MD@RT@Headers}{row}{%
			\def\MD@RT@ResolvedHeader{%
				\toprule
				\MD@RT@RowHeader
				\midrule
			}%
		}{%
			% headers=arguments: traditional 2/3/4-column syntax.
			\ifnum\MD@RT@ColumnCount=2\relax
				\def\MD@RT@ResolvedHeader{\MD@RT@HeaderTwo}%
			\else\ifnum\MD@RT@ColumnCount=3\relax
				\def\MD@RT@ResolvedHeader{\MD@RT@HeaderThree}%
			\else
				\def\MD@RT@ResolvedHeader{\MD@RT@HeaderFour}%
			\fi\fi
		}%
		\def\MD@RT@AutomaticStructure{%
			\MD@RT@ResolvedHeader\endfirsthead
			\MD@RT@ResolvedHeader\endhead
			\MD@RT@Foot
			\MD@RT@LastFoot
		}%
	}%
}

% ==========================================================================
% Modified ltablex finalizer
% ==========================================================================

\def\MD@RT@End{%
	
	% Save user body.
	
	\MD@RT@Body=\expandafter{\the\toks@}%
	
	
	% Build selected column specification.
	
	\MDRTPrepareXWeights
	\MD@RT@BuildColumnSpec
	\MD@RT@PrepareAutomaticStructure
	
	% Construct beginning of complete table.
	
	\toks@\expandafter{%
		\expandafter{\MD@RT@ColumnSpec}
		
		\MD@RT@CaptionBlock
		
		\MD@RT@AutomaticStructure
	}%
	
	
	% Append user body.
	
	\toks@\expandafter{%
		\the\toks@
		\the\MD@RT@Body
	}%
	
	
	% Standard tabularx / ltablex setup.
	
	\expandafter\TX@newcol
	\expandafter{\tabularxcolumn{\TX@col@width}}%
	
	\let\verb\TX@verb
	
	\def\@elt##1{%
		\global\value{##1}\the\value{##1}\relax
	}%
	
	\edef\TX@ckpt{\cl@@ckpt}%
	\let\@elt\relax
	
	\TX@old@table=\maxdimen
	\TX@col@width=\TX@target
	\global\TX@cols=\@ne
	
	\TX@typeout@{%
		\@spaces
		Table Width
		\@spaces
		Column Width
		\@spaces
		X Columns%
	}%
	
	
	% During trial passes longtable control commands behave as row endings.
	
	\let\MD@RT@savecaption\caption
	
	\def\caption{%
		\@ifstar
		\TX@cap@gobble
		\TX@cap@gobble
	}%
	
	\let\MD@RT@saveendhead\endhead
	\def\endhead{\\}%
	
	\let\MD@RT@saveendfirsthead\endfirsthead
	\def\endfirsthead{\\}%
	
	\let\MD@RT@saveendfoot\endfoot
	\def\endfoot{\\}%
	
	\let\MD@RT@saveendlastfoot\endlastfoot
	\def\endlastfoot{\\}%
	
	
	% Calculate X-column widths.
	
	\SuspendTagging{tabularx}%
	
	\ifTX@convertX@
	
	\TX@trial{%
		\def\NC@rewrite@X{\NC@find l}%
	}%
	
	\ifdim\wd\@tempboxa<\TX@target
	\TX@newcol{l}%
	\else
	\TX@convertX@false
	\fi
	
	\fi
	
	\ifTX@convertX@
	
	\relax
	
	\else
	
	\TX@trial{%
		\def\NC@rewrite@X{%
			\global\advance\TX@cols\@ne
			\NC@find p{\TX@col@width}%
		}%
	}%
	
	\loop
	\TX@arith
	\ifTX@
	\TX@trial{}%
	\repeat
	
	\fi
	
	\ResumeTagging{tabularx}%
	
	
	% Produce actual longtable.
	
	{%
		\let\@footnotetext\TX@ftntext
		\let\@xfootnotenext\TX@xftntext
		
		\LTchunksize\maxdimen
		
		\let\caption\MD@RT@savecaption
		\let\endhead\MD@RT@saveendhead
		\let\endfirsthead\MD@RT@saveendfirsthead
		\let\endfoot\MD@RT@saveendfoot
		\let\endlastfoot\MD@RT@saveendlastfoot
		
		\expandafter\longtable
		\the\toks@
		\endlongtable
	}%
	
	
	% Restore collected footnotes.
	
	\global\TX@ftn\expandafter{\expandafter}\the\TX@ftn
	
	\ifnum0=`{\fi}%
	
	
	% Close selected ReferenceTable area.
	
\end{MDReferenceTableArea}%

% The original \end{ReferenceTable} was consumed by the scanner.

\end{ReferenceTable}%
}


% ==========================================================================
% ReferenceTable
%
% Version 0.4.8
%
% Options:
%
%   area=full|half|text
%   marginwidth=<length>  (optional standalone geometry override)
%   gutter=<length>       (optional standalone geometry override)
%   xcolumns=...
%   typewritercolumns=...
%   verbatimcolumns=...
%   caption=...
%   label=...
%   trimleadingspaces=true|false
%   tabspaces=<non-negative integer>
%   headers=arguments|row|none|false
%   header=true|false  (compatibility alias)
%
% Defaults:
%
%   area=full
%   xcolumns=3
%   typewritercolumns=
%   verbatimcolumns=
%   trimleadingspaces=true
%   tabspaces=1
% ==========================================================================

% --------------------------------------------------------------------------
% Provisional classic 2/3/4-column heading parser (v0.3.1).
%
% columns=3 is the default, preserving the v0.3.0 syntax exactly.
% columns=2 and columns=4 explicitly select the experimental variants.
% The column count is known BEFORE heading arguments are consumed, so the
% verbatim scanner can start immediately after the final heading argument.
% No look-ahead into the table body is performed.
% --------------------------------------------------------------------------

\def\MD@RT@BeginAfterHeadings{%
% Preserve the v0.3.0 default rule: if xcolumns was not explicitly given,
% the last column is the X column.
\ifx\MD@RT@XColumns\@empty
\edef\MD@RT@XColumns{\MD@RT@ColumnCount}%
\fi
\MD@RT@SelectArea
\begin{MDReferenceTableArea}%
\let\TX@endtabularx=\MD@RT@End
\MD@RT@Start{\MD@RT@AreaWidth}%
}

\def\MD@RT@HeadingsTwo#1#2{%
\def\MD@RT@HeadingOne{#1}%
\def\MD@RT@HeadingTwo{#2}%
\def\MD@RT@HeadingThree{}%
\def\MD@RT@HeadingFour{}%
\MD@RT@BeginAfterHeadings
}

\def\MD@RT@HeadingsThree#1#2#3{%
\def\MD@RT@HeadingOne{#1}%
\def\MD@RT@HeadingTwo{#2}%
\def\MD@RT@HeadingThree{#3}%
\def\MD@RT@HeadingFour{}%
\MD@RT@BeginAfterHeadings
}

\def\MD@RT@HeadingsFour#1#2#3#4{%
\def\MD@RT@HeadingOne{#1}%
\def\MD@RT@HeadingTwo{#2}%
\def\MD@RT@HeadingThree{#3}%
\def\MD@RT@HeadingFour{#4}%
\MD@RT@BeginAfterHeadings
}

\def\MD@RT@DispatchHeadings{%
	\ifnum\MD@RT@ColumnCount=2\relax
		\let\MD@RT@Next\MD@RT@HeadingsTwo
	\else\ifnum\MD@RT@ColumnCount=3\relax
		\let\MD@RT@Next\MD@RT@HeadingsThree
	\else\ifnum\MD@RT@ColumnCount=4\relax
		\let\MD@RT@Next\MD@RT@HeadingsFour
	\else
		\PackageError{mdlayout-referencetable}%
		{headers=arguments currently supports only 2, 3, or 4 columns}%
		{Use headers=row or headers=none for an arbitrary number of columns.}%
		\def\MD@RT@ColumnCount{3}%
		\let\MD@RT@Next\MD@RT@HeadingsThree
	\fi\fi\fi
	\MD@RT@Next
}

\def\MD@RT@StartWithoutHeadings{%
	\def\MD@RT@HeadingOne{}%
	\def\MD@RT@HeadingTwo{}%
	\def\MD@RT@HeadingThree{}%
	\def\MD@RT@HeadingFour{}%
	\MD@RT@BeginAfterHeadings
}

\def\MD@RT@DispatchTableStart{%
	\ifnum\MD@RT@ColumnCount<1\relax
		\PackageError{mdlayout-referencetable}%
		{Invalid columns=\MD@RT@ColumnCount}%
		{The number of columns must be a positive integer.}%
		\def\MD@RT@ColumnCount{1}%
	\fi
	% Only headers=arguments consumes heading arguments.  Both headers=row
	% and headers=none begin the body immediately after the option list.
	\ifdefstring{\MD@RT@Headers}{arguments}{%
		\let\MD@RT@StartNext\MD@RT@DispatchHeadings
	}{%
		\let\MD@RT@StartNext\MD@RT@StartWithoutHeadings
	}%
	\MD@RT@StartNext
}

