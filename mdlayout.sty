% --------------------------------------------------------------------------
% Wide longtable context
%
% Provides FullArea geometry for longtable-based environments such as
% longtable and xltabular.
%
% xltabular initializes \LTleft and \LTright when the environment starts.
% Therefore the required FullArea alignment is injected into \LT@array,
% after that initialization but before the table alignment is constructed.
%
% The caption package derives an additional caption offset from \LTleft.
% Since \LTleft is intentionally negative here, the derived offset would
% move the caption to the right a second time. The local caption hook
% therefore resets this additional offset.
% --------------------------------------------------------------------------

\newenvironment{widelongtable}
{%
	\par
	\begingroup
	
	\begin{adjustwidth}{-\mdWideOffset}{0pt}%
		
		% Present FullArea as the local typesetting area.
		\textwidth=\linewidth
		\columnwidth=\linewidth
		\hsize=\linewidth
		
		% longtable/xltabular alignment:
		%
		% This patch is local because widelongtable starts a group.
		\@ifundefined{LT@array}
		{%
			\PackageError{mdlayout}
			{The longtable package is not loaded}
			{Load longtable or xltabular before using widelongtable.}%
		}
		{%
			\pretocmd{\LT@array}
			{%
				\LTleft=-\mdWideOffset\relax
				\LTright=0pt\relax
			}
			{}
			{%
				\PackageError{mdlayout}
				{Unable to configure wide longtable alignment}
				{The internal longtable command \string\LT@array could not be patched.}%
			}%
		}%
		
		% caption/ltcaption compatibility.
		\@ifundefined{caption@LT@config}
		{}
		{%
			\let\MD@SavedCaptionLTConfig\caption@LT@config
			
			\renewcommand*\caption@LT@config{%
				\MD@SavedCaptionLTConfig
				\xdef\caption@LTleft{0pt}%
				\xdef\caption@LTright{0pt}%
				\xdef\caption@LTfmt{@{}l@{}}%
			}%
		}%
	}
	{%
	\end{adjustwidth}%
	\endgroup
	\par
}

	

