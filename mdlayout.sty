% --------------------------------------------------------------------------
% mdlayout KOMA-Script defaults
%
% These defaults are applied only if the user has not explicitly specified
% the corresponding option in \documentclass.
%
% General class properties such as paper size, font size and one-/two-sided
% layout remain entirely under control of KOMA-Script.
% --------------------------------------------------------------------------

\newif\ifMD@UserDIV
\newif\ifMD@UserBCOR
\newif\ifMD@UserHeadings
\newif\ifMD@UserChapterPrefix

\MD@UserDIVfalse
\MD@UserBCORfalse
\MD@UserHeadingsfalse
\MD@UserChapterPrefixfalse

% Examine the options explicitly supplied to the document class.
\edef\MD@ClassOptions{\@classoptionslist}

% DIV=...
\in@{DIV=}{\MD@ClassOptions}
\ifin@
\MD@UserDIVtrue
\fi

% BCOR=...
\in@{BCOR=}{\MD@ClassOptions}
\ifin@
\MD@UserBCORtrue
\fi

% headings=...
\in@{headings=}{\MD@ClassOptions}
\ifin@
\MD@UserHeadingstrue
\fi

% chapterprefix may occur as
%
%   chapterprefix
%   chapterprefix=true
%   chapterprefix=false
%   headings=chapterprefix
%   headings=nochapterprefix
%
% Therefore testing for the word itself is intentional.
\in@{chapterprefix}{\MD@ClassOptions}
\ifin@
\MD@UserChapterPrefixtrue
\fi


% --------------------------------------------------------------------------
% Apply mdlayout defaults where the user has made no explicit choice.
% --------------------------------------------------------------------------

\ifMD@UserDIV
\else
\KOMAoptions{DIV=calc}%
\fi

\ifMD@UserBCOR
\else
\KOMAoptions{BCOR=5mm}%
\fi

\ifMD@UserHeadings
\else
\KOMAoptions{headings=normal}%
\fi

% chapterprefix is meaningful only for document classes
% that provide a chapter level (e.g. scrbook, scrreprt).
% Article classes such as scrartcl do not define \chapter.
\@ifundefined{chapter}{%
	% No chapter level: nothing to do.
}{%
	\ifMD@UserChapterPrefix
	\else
	\KOMAoptions{chapterprefix=true}%
	\fi
}

