% --------------------------------------------------------------------------
% Frame for next page
%
% Draws a frame on the next page to be shipped out.
% The frame is positioned relative to the physical paper, independently
% of TextArea, MarginArea and FullArea.
% --------------------------------------------------------------------------

\define@key{MDPageFrame}{color}{%
	\def\MD@PageFrameColor{#1}%
}

\define@key{MDPageFrame}{width}{%
	\def\MD@PageFrameWidth{#1}%
}

\define@key{MDPageFrame}{inset}{%
	\def\MD@PageFrameInset{#1}%
}

\newcommand*{\MD@DrawPageFrame}[3]{%
	\begingroup
	\color{#1}%
	\linethickness{#2}%
	\put(
	#3,
	-\dimexpr\paperheight-#3\relax
	){%
		\framebox(
		\dimexpr\paperwidth-#3-#3\relax,
		\dimexpr\paperheight-#3-#3\relax
		){}%
	}%
	\endgroup
}

\newcommand*{\FrameForNextPage}[1][]{%
	\def\MD@PageFrameColor{gray}%
	\def\MD@PageFrameWidth{1.5pt}%
	\def\MD@PageFrameInset{5mm}%
	%
	\setkeys{MDPageFrame}{#1}%
	%
	\edef\MD@Temp{%
		\noexpand\AddToHookNext{shipout/background}{%
			\noexpand\MD@DrawPageFrame
			{\MD@PageFrameColor}%
			{\MD@PageFrameWidth}%
			{\MD@PageFrameInset}%
		}%
	}%
	\MD@Temp
}


