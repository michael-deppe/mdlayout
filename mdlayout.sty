% --------------------------------------------------------------------------
% Full-width document title
%
% KOMA-Script remains responsible for all title semantics and title elements.
% mdlayout changes only the horizontal area used by \maketitle and by
% explicit titlepage environments.
% --------------------------------------------------------------------------

\newif\ifMD@InTitlePage
\MD@InTitlePagefalse

\newif\ifMD@WrapMakeTitle
\MD@WrapMakeTitlefalse

\newcommand*{\MD@UseFullTitlePageWidth}{%
	\oddsidemargin=\dimexpr
		\mdFullLeft-1in-\hoffset
	\relax
	\evensidemargin=\oddsidemargin
	\textwidth=\mdFullWidth
	\columnwidth=\textwidth
	\hsize=\columnwidth
	\linewidth=\hsize
}

\newcommand*{\MD@InstallWideTitle}{%
	% Optional company information is title metadata.  Keep KOMA-Script's
	% complete title machinery and place the company directly below author.
	\ifx\MD@Company\@empty
	\else
		\g@addto@macro\@author{%
			\\[.5em]%
			{\usekomafont{author}\MD@Company}%
		}%
	\fi

	% KOMA-Script cover pages derive their horizontal geometry from these
	% macros. Point them at the current FullArea.
	\@ifundefined{coverpageleftmargin}
	{}
	{%
		\renewcommand*{\coverpageleftmargin}{%
			\dimexpr\mdFullLeft-\hoffset\relax
		}%
	}%
	\@ifundefined{coverpagerightmargin}
	{}
	{%
		\renewcommand*{\coverpagerightmargin}{%
			\dimexpr\paperwidth+\hoffset-\mdFullRight\relax
		}%
	}%

	% Every titlepage uses the FullArea when widetitle=true.
	%
	% Append the geometry change to \titlepage itself instead of using
	% \AtBeginEnvironment.  KOMA-Script therefore performs the page break
	% starting the title page before mdlayout changes the horizontal geometry.
	% This prevents a preceding page (for example one containing \maketitle)
	% from being affected.
	%
	% The titlepage environment is grouped, so the original geometry is
	% restored automatically when the environment ends.
	\apptocmd{\titlepage}{%
		\MD@InTitlePagetrue
		\MD@UseFullTitlePageWidth
	}
	{}
	{%
		\PackageWarningNoLine{mdlayout}{%
			Could not patch titlepage for widetitle%
		}%
	}%

	% Decorative article-title rules for scrartcl.
	%
	% KOMA-Script's in-page \@maketitle is used only for titlepage=false.
	% The rules frame the title and subtitle, while subject, author, date,
	% publishers, and dedication retain KOMA-Script's own layout.
	\@ifclassloaded{scrartcl}{%
		\patchcmd{\@maketitle}
		{%
			{\usekomafont{title}{\huge \@title \par}}%
		}
		{%
			\ifdim\MDopt@articletitlerule>0pt\relax
				\MD@HeadingRule{\MDopt@articletitlerule}%
				\par\nobreak
				\vspace{\MDopt@articletitlerulegap}%
			\fi
			{\usekomafont{title}{\huge \@title \par}}%
		}
		{}
		{%
			\PackageWarningNoLine{mdlayout}{%
				Could not insert upper article-title rule%
			}%
		}%

		\patchcmd{\@maketitle}
		{%
			{\ifx\@subtitle\@empty\else\usekomafont{subtitle}\@subtitle\par\fi}%
			\vskip 1em
		}
		{%
			{\ifx\@subtitle\@empty\else\usekomafont{subtitle}\@subtitle\par\fi}%
			\ifdim\MDopt@articletitlerule>0pt\relax
				\par\nobreak
				\vspace{\MDopt@articletitlerulegap}%
				\MD@HeadingRule{\MDopt@articletitlerule}%
			\fi
			\vskip 1em
		}
		{}
		{%
			\PackageWarningNoLine{mdlayout}{%
				Could not insert lower article-title rule%
			}%
		}%
	}{}%

	% In-page title (normally scrartcl with titlepage=false).
	%
	% If \@maketitle is executed inside a titlepage, that page already uses
	% FullArea geometry and must not be shifted a second time.
	\pretocmd{\@maketitle}{%
		\ifMD@InTitlePage
			\MD@WrapMakeTitlefalse
		\else
			\MD@WrapMakeTitletrue
			\begin{FullArea}%
			\setlength{\textwidth}{\linewidth}%
			\setlength{\columnwidth}{\linewidth}%
			\setlength{\hsize}{\linewidth}%
		\fi
	}
	{}
	{%
		\PackageWarningNoLine{mdlayout}{%
			Could not patch \string\@maketitle\space for widetitle%
		}%
	}%

	\apptocmd{\@maketitle}{%
		\ifMD@WrapMakeTitle
			\end{FullArea}%
		\fi
	}
	{}
	{%
		\PackageWarningNoLine{mdlayout}{%
			Could not close FullArea in \string\@maketitle%
		}%
	}%
}

