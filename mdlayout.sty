\newfontfamily\mdlogofont{TeX Gyre Heros}

\DeclareRobustCommand{\mdlayout}{%
	\mbox{%
		{\mdlogofont\bfseries\color{mdColorPrimary}md}%
		{\mdlogofont layout}%
	}%
}

\makeatletter

\def\MD@ParseVersion#1.#2.#3\@nil{%
	\edef\mdlayoutRevisionNumber{%
		\ifnum#1<10 0\fi#1%
		\ifnum#2<10 0\fi#2%
		\ifnum#3<10 0\fi#3%
	}%
}

\expandafter\MD@ParseVersion\mdlayoutVersion\@nil

\makeatother

% Revision
\newcommand*{\IfMDLayoutRevisionAtLeast}[2]{%
	\ifnum\mdlayoutRevisionNumber<#1\relax
	\else
	#2%
	\fi
}

