% Width of the usable part of the wide left margin.
\DeclareStringOption[\mdDefaultMarginwidth]{marginwidth}

% Minimum widths for automatic adaptation on narrow paper.
\DeclareStringOption[\mdDefaultMinmarginwidth]{minmarginwidth}
\DeclareStringOption[\mdDefaultMintextwidth]{mintextwidth}

% Horizontal separation between margin area and normal text column.
\DeclareStringOption[\mdDefaultGutter]{gutter}

% Physical right page margin.
% The default mdlayout design uses a fixed right margin.
% An empty value (\usepackage[rightmargin=]{mdlayout})
% retains KOMA-Script's calculated right margin.
\DeclareStringOption[\mdDefaultRightmargin]{rightmargin}

% Minimum physical distance between the left paper edge and FullArea.
% This value is used only when the layout has to be adapted on narrow paper.
\DeclareStringOption[\mdDefaultMinleftmargin]{minleftmargin}

% Move the document title to the FullArea while retaining KOMA-Script's
% complete title logic.
\DeclareBoolOption[\mdDefaultWidetitle]{widetitle}

% Move KOMA-Script headings to the left edge of the FullArea.
\DeclareBoolOption[\mdDefaultWideheadings]{wideheadings}

% Extend page headers and footers over the FullArea.
\DeclareBoolOption[\mdDefaultWideheadfoot]{wideheadfoot}

% Thickness of the separator below the page header. Use false to disable it.
\DeclareStringOption[\mdDefaultHeadsepline]{headsepline}

% Also show the separator on plain chapter-opening pages.
\DeclareBoolOption[\mdDefaultPlainheadsepline]{plainheadsepline}

% Physical distance between the lower edge of the text area and the paper.
% If empty, KOMA-Script's calculated text height is retained.
\DeclareStringOption[\mdDefaultBottommargin]{bottommargin}

% Heading and article-title rules inspired by technical manuals.
% A value of 0pt disables the corresponding rule.
\DeclareStringOption[\mdDefaultArticletitlerule]{articletitlerule}
\DeclareStringOption[\mdDefaultChapterrule]{chapterrule}
\DeclareStringOption[\mdDefaultSectionrule]{sectionrule}
\DeclareStringOption[\mdDefaultHeadingrulecolor]{headingrulecolor}

\DeclareStringOption[\mdDefaultArticletitlerulegap]{articletitlerulegap}
\DeclareStringOption[\mdDefaultChapterrulegap]{chapterrulegap}
\DeclareStringOption[\mdDefaultSectionrulegap]{sectionrulegap}

