% --------------------------------------------------------------------------
% Layout calculation
% --------------------------------------------------------------------------

\newcommand*{\MD@CalculateLayout}{%
	\mdTextWidth=\MD@OriginalTextWidth
	\mdMarginWidth=\MDopt@marginwidth\relax
	\mdMinMarginArea=\MDopt@minmarginwidth\relax
	\mdMinTextArea=\MDopt@mintextwidth\relax
	\mdGutterWidth=\MDopt@gutter\relax
	\mdMinLeftMargin=\MDopt@minleftmargin\relax

	\MD@OriginalRightMargin=\dimexpr
		\paperwidth-1in-\hoffset-\MD@OriginalOddSideMargin-\MD@OriginalTextWidth
	\relax
	\ifdefempty{\MDopt@rightmargin}
	{\mdRightMargin=\MD@OriginalRightMargin}
	{\mdRightMargin=\MDopt@rightmargin\relax}%
	\MD@AvailableWidth=\dimexpr
		\paperwidth-\mdRightMargin-\mdMinLeftMargin
	\relax

	% Validate fixed and minimum dimensions.
	\ifdim\mdMarginWidth<0pt
		\PackageError{mdlayout}{Negative margin width}
		{The marginwidth option must not be negative.}%
	\fi
	\ifdim\mdMinMarginArea<0pt
		\PackageError{mdlayout}{Negative minimum margin width}
		{The minmarginwidth option must not be negative.}%
	\fi
	\ifdim\mdMinTextArea<0pt
		\PackageError{mdlayout}{Negative minimum text width}
		{The mintextwidth option must not be negative.}%
	\fi
	\ifdim\mdGutterWidth<0pt
		\PackageError{mdlayout}{Negative gutter width}
		{The gutter option must not be negative.}%
	\fi
	\ifdim\mdRightMargin<0pt
		\PackageError{mdlayout}{Negative right margin}
		{The rightmargin option must not be negative.}%
	\fi

	\ifdim\mdMinLeftMargin<0pt
		\PackageError{mdlayout}{Negative minimum left margin}
		{The minleftmargin option must not be negative.}%
	\fi

	% A minimum larger than the requested width cannot enlarge the layout.
	\ifdim\mdMinMarginArea>\mdMarginWidth
		\mdMinMarginArea=\mdMarginWidth
	\fi
	\ifdim\mdMinTextArea>\mdTextWidth
		\mdMinTextArea=\mdTextWidth
	\fi

	% Stage 1: reduce MarginArea first.
	\@tempdima=\dimexpr\mdTextWidth+\mdMarginWidth+\mdGutterWidth\relax
	\ifdim\@tempdima>\MD@AvailableWidth
		\@tempdimb=\mdMarginWidth
		\mdMarginWidth=\dimexpr\MD@AvailableWidth-\mdTextWidth-\mdGutterWidth\relax
		\ifdim\mdMarginWidth<\mdMinMarginArea
			\mdMarginWidth=\mdMinMarginArea
		\fi
		\ifdim\mdMarginWidth<\@tempdimb
			\PackageWarningNoLine{mdlayout}{%
				The requested layout is too wide for the current paper size.\MessageBreak
				MarginArea reduced from \the\@tempdimb\space to \the\mdMarginWidth%
			}%
		\fi
	\fi

	% Stage 2: after MarginArea reaches its minimum, reduce TextArea.
	\@tempdima=\dimexpr\mdTextWidth+\mdMarginWidth+\mdGutterWidth\relax
	\ifdim\@tempdima>\MD@AvailableWidth
		\@tempdimb=\mdTextWidth
		\mdTextWidth=\dimexpr\MD@AvailableWidth-\mdMarginWidth-\mdGutterWidth\relax
		\ifdim\mdTextWidth<\mdMinTextArea
			\mdTextWidth=\mdMinTextArea
		\fi
		\ifdim\mdTextWidth<\@tempdimb
			\PackageWarningNoLine{mdlayout}{%
				MarginArea has reached its minimum width of \the\mdMarginWidth.\MessageBreak
				TextArea reduced from \the\@tempdimb\space to \the\mdTextWidth%
			}%
		\fi
	\fi

	% Below both minima there is no valid mdlayout geometry.
	\@tempdima=\dimexpr\mdTextWidth+\mdMarginWidth+\mdGutterWidth\relax
	\ifdim\@tempdima>\MD@AvailableWidth
		\PackageError{mdlayout}
		{Paper too narrow for minimum mdlayout dimensions}
		{Paper width: \the\paperwidth\MessageBreak
			Minimum left margin: \the\mdMinLeftMargin\MessageBreak
			Minimum MarginArea: \the\mdMinMarginArea\MessageBreak
			Gutter: \the\mdGutterWidth\MessageBreak
			Minimum TextArea: \the\mdMinTextArea\MessageBreak
			Right margin: \the\mdRightMargin\MessageBreak
			Use a larger paper size or reduce minmarginwidth or mintextwidth.}%
	\fi

	% Recalculate all dependent dimensions from the adapted widths.
	\mdWideOffset=\dimexpr\mdMarginWidth+\mdGutterWidth\relax
	\mdHalfOffset=.5\mdWideOffset
	\mdHalfWidth=\dimexpr\mdTextWidth+\mdHalfOffset\relax
	\mdFullWidth=\dimexpr\mdTextWidth+\mdWideOffset\relax
	\mdTextRight=\dimexpr\paperwidth-\mdRightMargin\relax
	\mdTextLeft=\dimexpr\mdTextRight-\mdTextWidth\relax
	\mdFullRight=\mdTextRight
	\mdFullLeft=\dimexpr\mdFullRight-\mdFullWidth\relax

	% By construction FullArea must not cross the minimum physical left margin.
	\ifdim\mdFullLeft<\mdMinLeftMargin
		\PackageError{mdlayout}
		{Calculated FullArea violates minimum left margin}
		{FullArea starts at \the\mdFullLeft,\MessageBreak
			but minleftmargin is \the\mdMinLeftMargin.}%
	\fi

	\mdMarginLeft=\mdFullLeft
	\mdMarginRight=\dimexpr\mdMarginLeft+\mdMarginWidth\relax

	% The normal text column deliberately occupies the same physical position
	% on odd and even pages.
	\oddsidemargin=\dimexpr
	\mdTextLeft-1in-\hoffset
	\relax
	\evensidemargin=\oddsidemargin
	
	\textwidth=\mdTextWidth
	\columnwidth=\textwidth
	\linewidth=\textwidth
	\hsize=\textwidth
	
	\fullwidth=\mdFullWidth
	\marginwidth=\mdMarginWidth
	\gutterwidth=\mdGutterWidth
	\wideoffset=\mdWideOffset
	\megatextindent=-\mdWideOffset
	\textindent=-\mdWideOffset
	
	% Retain KOMA-Script's upper text position. If bottommargin is given,
	% adjust only the lower edge by changing \textheight.
	\MD@TextTop=\dimexpr
	1in+\voffset+\topmargin+\headheight+\headsep
	\relax
	
	\ifdefempty{\MDopt@bottommargin}
	{\mdBottomMargin=\dimexpr\paperheight-\MD@TextTop-\textheight\relax}
	{%%
		\mdBottomMargin=\MDopt@bottommargin\relax
		\ifdim\mdBottomMargin<0pt
		\PackageError{mdlayout}
		{Negative bottom margin}
		{The bottommargin option must not be negative.}%%
		\fi
		\textheight=\dimexpr
		\paperheight-\MD@TextTop-\mdBottomMargin
		\relax
		\ifdim\textheight<\baselineskip
		\PackageError{mdlayout}
		{Calculated text height is too small}
		{Reduce bottommargin or use a taller paper size.}%%
		\fi
	}%%
	
	\ifMDopt@showlayout
	\MD@WriteLayoutToLog
	\fi
}

\newcommand*{\MD@WideHeadingShift}{%
	\dimexpr-\mdWideOffset+\MD@HeadingAreaOffset\relax
}

% --------------------------------------------------------------------------
% Diagnostic information
% --------------------------------------------------------------------------

\newcommand*{\MD@WriteLayoutToLog}{%
	\PackageInfo{mdlayout}{%
		\MessageBreak
		========================================\MessageBreak
		mdlayout calculated geometry\MessageBreak
		========================================\MessageBreak
		Paper width       = \the\paperwidth\MessageBreak
		Paper height      = \the\paperheight\MessageBreak
		Original text width = \the\MD@OriginalTextWidth\MessageBreak
		Text width        = \the\mdTextWidth\MessageBreak
		Text height       = \the\textheight\MessageBreak
		----------------------------------------\MessageBreak
		Margin width      = \the\mdMarginWidth\MessageBreak
		Gutter width      = \the\mdGutterWidth\MessageBreak
		Wide offset       = \the\mdWideOffset\MessageBreak
		Full width        = \the\mdFullWidth\MessageBreak
		----------------------------------------\MessageBreak
		Full left edge    = \the\mdFullLeft\MessageBreak
		Full right edge   = \the\mdFullRight\MessageBreak
		Margin left edge  = \the\mdMarginLeft\MessageBreak
		Margin right edge = \the\mdMarginRight\MessageBreak
		Text left edge    = \the\mdTextLeft\MessageBreak
		Text right edge   = \the\mdTextRight\MessageBreak
		----------------------------------------\MessageBreak
		Right margin      = \the\mdRightMargin\MessageBreak
		Min left margin   = \the\mdMinLeftMargin\MessageBreak
		Bottom margin     = \the\mdBottomMargin\MessageBreak
		HalfArea offset   = \the\mdHalfOffset\MessageBreak
		HalfArea width    = \the\mdHalfWidth\MessageBreak
		========================================%
	}%
}

% ==========================================================
% ==========================================================
% Area environments
%
% TextArea       : normal text width
% HalfArea       : extends into half of the margin area
% FullArea       : extends into the complete margin area
% DirectoryArea  : semantic alias of HalfArea for directories
%                  (ToC, LoF, LoT, bibliography, glossary, index)
%
% All area environments automatically compensate wide headings.
% ==========================================================

% ==========================================================
% Text areas
% ==========================================================

\newenvironment{HalfArea}
{%
	\par
	\begingroup
	\MD@HeadingAreaOffset=\dimexpr\mdWideOffset/2\relax
	\begin{adjustwidth}
		{-\dimexpr\mdWideOffset/2\relax}
		{0pt}%
	}
	{%
	\end{adjustwidth}%
	\endgroup
	\par
}

\newenvironment{FullArea}
{%
	\par
	\begingroup
	\MD@HeadingAreaOffset=\mdWideOffset
	\begin{adjustwidth}
		{-\mdWideOffset}
		{0pt}%
	}
	{%
	\end{adjustwidth}%
	\endgroup
	\par
}

% ==========================================================
% Directory area
% ==========================================================

\newenvironment{DirectoryArea}
{%
	\begin{HalfArea}
	}
	{%
	\end{HalfArea}
}

% ==========================================================================
% Synchronized MarginArea + TextArea
%
% Places two related objects side by side:
%
%   MarginArea        Gutter        TextArea
%   ┌───────────┐                  ┌──────────────────────────────┐
%   │ margin    │                  │ text                         │
%   │ object    │                  │ object                       │
%   └───────────┘                  └──────────────────────────────┘
%
% Both objects start at exactly the same vertical position.
% ==========================================================================

\newcommand{\SyncMarginAndTextArea}[2]{%
	\par
	\noindent
	\hspace*{-\mdWideOffset}%
	%
	\begin{minipage}[t]{\mdMarginWidth}%
		\vspace{0pt}%
		#1%
	\end{minipage}%
	%
	\hspace{\mdGutterWidth}%
	%
	\begin{minipage}[t]{\mdTextWidth}%
		\vspace{0pt}%
		#2%
	\end{minipage}%
	%
	\par
	\addvspace{\topsep}%
}

% ==========================================================================
% SynchronizedMarginAndTextArea
%
% Environment form of mdlayout's synchronized MarginArea + TextArea layout.
% The two minipages are unbreakable and therefore move together at a page
% break, exactly like the existing \SyncMarginAndTextArea command.
% ==========================================================================

\newenvironment{SynchronizedMarginAndTextArea}
{%
	\par
	\noindent
	\hspace*{-\mdWideOffset}%
	\ignorespaces
}
{%
	\unskip
	\par
	\addvspace{\topsep}%
}

% ==========================================================================
% TextInMarginArea
%
% Normal LaTeX in the fixed mdlayout MarginArea.
% ==========================================================================

\newenvironment{TextInMarginArea}
{%
	\begin{minipage}[t]{\mdMarginWidth}%
		\vspace{0pt}%
		\ignorespaces
	}
	{%
		\unskip
	\end{minipage}%
	\hspace{\mdGutterWidth}%
	\ignorespaces
}

% ==========================================================================
% TextInTextArea
%
% Normal LaTeX in the normal mdlayout TextArea.
% ==========================================================================

\newenvironment{TextInTextArea}
{%
	\begin{minipage}[t]{\mdTextWidth}%
		\vspace{0pt}%
		\ignorespaces
	}
	{%
		\unskip
	\end{minipage}%
	\ignorespaces
}

% ==========================================================================
% VerbatimInTextArea
%
% Genuine verbatim material in the normal mdlayout TextArea.
%
% \VerbatimEnvironment MUST be the first operation in the begin code.  It
% instructs fancyvrb/fvextra to use VerbatimInTextArea itself as the scanner
% delimiter, so #, $, %, _, {, }, \, ~, etc. are read before normal TeX
% tokenization can interpret them.
% ==========================================================================

\newenvironment{VerbatimInTextArea}
{%
	\VerbatimEnvironment
	\begin{minipage}[t]{\mdTextWidth}%
		\vspace{0pt}%
		\begin{Verbatim}
		}
		{%
		\end{Verbatim}%
	\end{minipage}%
	\ignorespaces
}


% --------------------------------------------------------------------------
% MarginFigure
%
% Places a non-floating, referenceable figure in the fixed MarginArea,
% i.e. the column to the left of TextArea and inside FullArea.
%
% Geometry:
%
%   MarginArea | Gutter | TextArea
%
% The figure is anchored at the current text position. It does not use
% LaTeX's \marginpar mechanism, because MarginArea is not an outer margin.
% MarginFigure is a non-floating figure placed at the exact source position. 
% It is intended for small illustrations beside sufficiently long text passages.
% The author is responsible for choosing a position that avoids collisions and
% page overflow. 
% For automatic placement, use the standard figure or widefigure environment.
% --------------------------------------------------------------------------
\newcommand*{\MD@MarginFigureFontSize}{\footnotesize}

\DeclareCaptionFont{MDMarginFigureFont}{%
	\MD@MarginFigureFontSize
}

\newsavebox{\MD@MarginFigureBox}

\DeclareCaptionFont{MDMarginFigureFont}{%
	\MD@MarginFigureFontSize
}

\newenvironment{MarginFigure}[1][\footnotesize]
{%
