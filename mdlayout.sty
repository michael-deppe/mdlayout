% --------------------------------------------------------------------------
% Version check
% --------------------------------------------------------------------------

\def\MD@ExtractPackageVersion#1 #2 #3\@nil{#2}

\newcommand*\MD@CheckPackageVersion[3]{%
	\@ifpackageloaded{#1}{%
		
		\edef\MD@PackageInfo{%
			\csname ver@#1.sty\endcsname
		}%
		
		\edef\MD@ActualVersion{%
			\expandafter\MD@ExtractPackageVersion
			\MD@PackageInfo\space\@nil
		}%
		
		\edef\MD@ExpectedVersion{#2}%
		
		\ifdefstrequal{\MD@ActualVersion}{\MD@ExpectedVersion}
		{%
			% Versions match
		}
		{%
			\PackageError{mdlayout}{%
				Incompatible version of #1.sty\MessageBreak
				Required version: \MD@ExpectedVersion\MessageBreak
				Installed version: \MD@ActualVersion
			}{%
				The mdlayout package files are inconsistent.\MessageBreak
				Please install #1.sty version \MD@ExpectedVersion\MessageBreak
				or install a matching complete mdlayout package set.\MessageBreak
				#3%
			}%
		}%
		
	}{%
		\PackageError{mdlayout}{%
			Required package #1.sty is not loaded\MessageBreak
			Required version: #2
		}{%
			The mdlayout package files are incomplete.\MessageBreak
			Please install the complete matching mdlayout package set.\MessageBreak
			#3%
		}%
	}%
}

\MD@CheckPackageVersion
{mdlayout-printout}
{\mdlayoutPrintoutVersion}
{Please install the matching mdlayout-printout.sty.}

\MD@CheckPackageVersion
{mdlayout-referencetable}
{\mdlayoutReferenceTableVersion}
{Please install the matching mdlayout-referencetable.sty.}


% --------------------------------------------------------------------------
% Wide KOMA-Script headings and optional IBM-style rules
%
% Only geometry and decorative rules are changed. Numbering, chapter
% prefixes, language, fonts, and all semantic heading behaviour remain under
% KOMA-Script control.
% --------------------------------------------------------------------------

\newcommand*{\MD@HeadingRule}[1]{%
	\begingroup
	\color{\MDopt@headingrulecolor}%
	\noindent\rule{\linewidth}{#1}%
	\endgroup
}

\newcommand*{\MD@ChapterHeadingContents}[4]{%
	\ifdim\MDopt@chapterrule>0pt\relax
	\MD@HeadingRule{\MDopt@chapterrule}%
	\par\nobreak
	\vspace{\MDopt@chapterrulegap}%
	\fi
	#1{#2}{#3}{#4}%
}

\newcommand*{\MD@SectionHeadingContents}[5]{%
	#1{#2}{#3}{#4}{#5}%
	\ifstrequal{#2}{section}{%
		\ifdim\MDopt@sectionrule>0pt\relax
		\par\nobreak
		\vspace{\MDopt@sectionrulegap}%
		\MD@HeadingRule{\MDopt@sectionrule}%
		\fi
	}{}%
}

\newcommand*{\MD@InstallWideHeadings}{%
	
	% Part headings.
	\@ifundefined{partlinesformat}
	{}
	{%
		\renewcommand*{\partlinesformat}[3]{%
			\hspace*{\MD@WideHeadingShift}%
			\parbox[t]{\mdFullWidth}{%
				\raggedpart
				\@hangfrom{##2}{##3}%
			}%
		}%
	}%
	
	\@ifundefined{partlineswithprefixformat}
	{}
	{%
		\renewcommand*{\partlineswithprefixformat}[3]{%
			\hspace*{\MD@WideHeadingShift}%
			\parbox[t]{\mdFullWidth}{%
				\raggedpart
				##2##3%
			}%
		}%
	}%
	
	% Chapter headings without a separate prefix line. This path is also used
	% for unnumbered chapter-level headings such as the table of contents,
	% list of figures, and list of tables.
	\@ifundefined{chapterlinesformat}
	{}
	{%
		\renewcommand*{\chapterlinesformat}[3]{%
			\hspace*{\MD@WideHeadingShift}%
			\parbox[t]{\mdFullWidth}{%
				\raggedchapter
				\ifdim\MDopt@chapterrule>0pt\relax
				\MD@HeadingRule{\MDopt@chapterrule}%
				\par\nobreak
				\vspace{\MDopt@chapterrulegap}%
				\fi
				\@hangfrom{##2}{##3}%
			}%
		}%
	}%
	
	% Chapter headings with KOMA-Script's separate chapter-prefix line.
	\@ifundefined{chapterlineswithprefixformat}
	{}
	{%
		\renewcommand*{\chapterlineswithprefixformat}[3]{%
			\hspace*{\MD@WideHeadingShift}%
			\parbox[t]{\mdFullWidth}{%
				\raggedchapter
				\ifdim\MDopt@chapterrule>0pt\relax
				\MD@HeadingRule{\MDopt@chapterrule}%
				\par\nobreak
				\vspace{\MDopt@chapterrulegap}%
				\fi
				##2##3%
			}%
		}%
	}%
	
	% Section-like headings. Only section receives a rule; lower levels keep
	% KOMA-Script's normal appearance.
	\@ifundefined{sectionlinesformat}
	{}
	{%
		\renewcommand*{\sectionlinesformat}[4]{%
			\hspace*{\MD@WideHeadingShift}%
			\parbox[t]{\mdFullWidth}{%
				\raggedsection
				\ifstrequal{##1}{section}
				{%
					\ifdim\MDopt@sectionrule>0pt\relax
					\MD@HeadingRule{\MDopt@sectionrule}%
					\par\nobreak
					\vspace{\MDopt@sectionrulegap}%
					\fi
				}
				{}%
				\@hangfrom{\hskip ##2##3}{##4}%
			}%
		}%
	}%
}

% --------------------------------------------------------------------------
% Full-width page headers and footers
% --------------------------------------------------------------------------

\newcommand*{\MD@InstallWideHeadFoot}{%
	\KOMAoptions{%
		headwidth=\mdFullWidth:-\mdWideOffset:\mdWideOffset,
		footwidth=\mdFullWidth:-\mdWideOffset:\mdWideOffset,
		headsepline=\MDopt@headsepline
	}%
	
	\ifMDopt@plainheadsepline
	\KOMAoptions{plainheadsepline=true}%
	\else
	\KOMAoptions{plainheadsepline=false}%
	\fi
}

\newcommand*{\MD@InstallPageStyle}{%
	\clearpairofpagestyles
	
	\@ifclassloaded{scrartcl}
	{\automark[subsection]{section}}
	{\automark[section]{chapter}}%
	
	\if@twoside
	% Normal even pages:
	% page number on the left, running heading on the right.
	\lehead[]{\pagemark}%
	\rehead[]{\headmark}%
	
	% Normal odd pages:
	% running heading on the left, page number on the right.
	\lohead[]{\headmark}%
	\rohead[]{\pagemark}%
	\else
	% Normal one-sided pages:
	% running heading on the left, page number on the right.
	\lohead[]{\headmark}%
	\rohead[]{\pagemark}%
	\fi
	
	% Chapter-opening pages use plain.scrheadings:
	% no running header, only a centered page number in the footer.
	\cfoot[\pagemark]{}%
	
	% Optional company information for scrbook and scrreprt.  It is always
	% placed at the physical left side of the footer, below MarginArea.
	% The optional arguments also show it on plain chapter-opening pages.
	% Existing headers, including their page numbers, are not changed.
	\@ifclassloaded{scrartcl}{}{%
		\ifx\MD@Company\@empty
		\else
			\lefoot[\MD@Company]{\MD@Company}%
			\lofoot[\MD@Company]{\MD@Company}%
		\fi
	}%
	
	\pagestyle{scrheadings}%
}

% --------------------------------------------------------------------------
% Public recalculation command
% --------------------------------------------------------------------------

\newcommand*{\mdlayoutrecalculate}{%
	\MD@OriginalTextWidth=\textwidth
	\MD@OriginalOddSideMargin=\oddsidemargin
	\MD@OriginalEvenSideMargin=\evensidemargin
	
	\MD@CalculateLayout
	
	\ifMDopt@wideheadings
	\MD@InstallWideHeadings
	\fi
	
	\ifMDopt@wideheadfoot
	\MD@InstallWideHeadFoot
	\MD@InstallPageStyle
	\fi
}

